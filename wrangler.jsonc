{
  "name": "lifeolozy",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "rules": [{ "type": "Text", "globs": ["**/*.html", "**/*.css"], "fallthrough": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "lifeolozy-db", "database_id": "PASTE_YOUR_D1_ID_HERE" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "lifeolozy-images" }]
}
